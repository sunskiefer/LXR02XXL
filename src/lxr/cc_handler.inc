				}
				else
				{
					transient_setWaveform(&voiceArray[2].transGen, value.itg);
				}
				break;

			case CC2_TRANS3_VOL:
				voiceArray[2].transGen.volume = value.flt;
				break;

			case CC2_TRANS3_FREQ:
				voiceArray[2].transGen.pitch = 1.f + ((value.itg/33.9f)-0.75f) ;
				break;

			case CC2_TRANS4_WAVE:

				}
				break;

			case CC2_FILTER_TYPE_4:
				if(isFloatModulator)
				{
					uint8_t type = FILTER_NAIVE_2_POLE * value.flt + 1;
					type = type >= FILTER_OFF ? FILTER_OFF-1 : type;

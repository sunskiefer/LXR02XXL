				}
				else
				{
					snareVoice.filterType = value.itg + 1; // +1 because 0 is filter off which results in silence
				}
				break;

			case CC2_FILTER_TYPE_5:
				//cymbal filter
				if(isFloatModulator)
				{
					uint8_t type = FILTER_NAIVE_2_POLE * value.flt + 1;
